{
  "name": "@begraffic/email",
  "version": "0.1.0",
  "description": "Editor visual de email, compositor rich-text y motor de render (React Email)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": { "type": "git", "url": "git+https://github.com/BeGraffic/be-email.git" },
  "files": ["dist"],
  "exports": {
    "./render": { "types": "./dist/render/index.d.ts", "import": "./dist/render/index.js" },
    "./editor": { "types": "./dist/editor/index.d.ts", "import": "./dist/editor/index.js" },
    "./composer": { "types": "./dist/composer/index.d.ts", "import": "./dist/composer/index.js" }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "prepublishOnly": "pnpm verify"
  },
  "peerDependencies": { "react": "^19", "react-dom": "^19" },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "isomorphic-dompurify": "^3.22.0",
    "lucide-react": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8",
    "typescript": "^6.0.2",
    "vitest": "^4.1.5"
  },
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public" }
}
